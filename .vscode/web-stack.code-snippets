      "",
      "/* #CAPTCHA — reg.html → !captcha + !captcha-js */",
      "app.get('/api/captcha', (req, res) => {",
      "  const a = Math.floor(Math.random() * 9) + 1;",
      "  const b = Math.floor(Math.random() * 9) + 1;",
      "  const token = require('crypto').randomBytes(16).toString('hex');",
      "  try {",
      "    db.prepare('INSERT INTO captcha_sessions (token, answer) VALUES (?, ?)').run(token, a + b);",
      "  } catch {",
      "    /* таблица captcha_sessions — создаётся в !db-garden */",
      "  }",
      "  res.json({ question: `\\${a} + \\${b} = ?`, token });",
      "});",
      "",
      "function verifyCaptcha(token, answer) {",
      "  if (!token || answer === undefined) return false;",
      "  const row = db.prepare('SELECT answer FROM captcha_sessions WHERE token = ?').get(token);",
      "  if (!row) return false;",
      "  db.prepare('DELETE FROM captcha_sessions WHERE token = ?').run(token);",
      "  return Number(answer) === row.answer;",
      "}",
      "",
      "/* #CAPTCHA_ПРОВЕРКА — добавьте в POST /register перед созданием user:",
      "   if (!verifyCaptcha(req.body.captcha_token, req.body.captcha_answer)) {",
      "     return res.redirect('/reg.html?error=captcha');",
      "   }",
      "   Регистрация присваивает role client (role_id = 2) — ТЗ",
      "*/",
      "",
      "/* #МАРШРУТ_ГОСТЬ_КАТАЛОГ — login.html → !guest-button → catalog.html (ТЗ) */",
      "app.post('/api/guest-login', (req, res) => {",
      "  req.session.userId = 0;",
      "  req.session.login = 'guest';",
      "  req.session.role = 'guest';",
      "  req.session.role_name = 'guest';",
      "  res.json({ redirect: '/catalog.html' });",
      "});",
      "",
      "app.get('/catalog.html', (req, res) => {",
      "  res.sendFile(path.join(__dirname, 'public', 'catalog.html'));",
      "});",
      "",
      "app.get('/orders.html', requireAuth, (req, res) => {",
      "  const role = req.session.role_name || req.session.role;",
      "  if (!['manager', 'admin'].includes(role)) {",
      "    return res.redirect('/catalog.html');",
      "  }",
      "  res.sendFile(path.join(__dirname, 'public', 'orders.html'));",
      "});",
      "",
      "/* #ROLE_GUARD — middleware → сниппет !role-guard */",
      "function requireRole(...roles) {",
      "  return (req, res, next) => {",
      "    const role = req.session.role_name || req.session.role;",
      "    if (!roles.includes(role)) {",
      "      return res.status(403).json({ message: 'Недостаточно прав: ' + roles.join(', ') });",
      "    }",
      "    next();",
      "  };",
      "}",
      "",
      "/* #API_КАТАЛОГ — catalog.html + !catalog-js */",
      "app.get('/api/products', (req, res) => {",
      "  const { search, sort, category, type, condition } = req.query;",
      "  let sql = 'SELECT * FROM products WHERE 1=1';",
      "  const params = [];",
      "",
      "  if (search) {",
      "    sql += ' AND (name LIKE ? OR article LIKE ?)';",
      "    params.push(`%\\${search}%`, `%\\${search}%`);",
      "  }",
      "  if (category) { sql += ' AND category = ?'; params.push(category); }",
      "  if (type) { sql += ' AND type = ?'; params.push(type); }",
      "  if (condition) {",
      "    sql += ' AND id IN (SELECT product_id FROM product_condition_link WHERE condition_id = ?)';",
      "    params.push(condition);",
      "  }",
      "",
      "  if (sort === 'price_asc') sql += ' ORDER BY price ASC';",
      "  else if (sort === 'price_desc') sql += ' ORDER BY price DESC';",
      "  else if (sort === 'name_asc') sql += ' ORDER BY name ASC';",
      "  else if (sort === 'date_desc') sql += ' ORDER BY created_at DESC';",
      "  else sql += ' ORDER BY id DESC';",
      "",
      "  try {",
      "    res.json(db.prepare(sql).all(...params));",
      "  } catch {",
      "    res.json([]);",
      "  }",
      "});",
      "",
      "app.get('/api/growing-conditions', (req, res) => {",
      "  try {",
      "    res.json(db.prepare('SELECT * FROM growing_conditions').all());",
      "  } catch {",
      "    res.json([]);",
      "  }",
      "});",
      "",
      "/* #API_ЗАКАЗЫ — orders.html + !orders-js (manager: read, admin: CRUD) */",
      "app.get('/api/orders', requireAuth, requireRole('manager', 'admin'), (req, res) => {",
      "  const orders = db.prepare(`",
      "    SELECT o.*, u.full_name as client_name",
      "    FROM orders o",
      "    LEFT JOIN users u ON u.id = o.user_id",
      "    ORDER BY o.id DESC",
      "  `).all();",
      "  res.json(orders);",
      "});",
      "",
      "app.get('/api/orders/:id', requireAuth, requireRole('manager', 'admin'), (req, res) => {",
      "  const order = db.prepare(`",
      "    SELECT o.*, u.full_name as client_name FROM orders o",
      "    LEFT JOIN users u ON u.id = o.user_id WHERE o.id = ?",
      "  `).get(req.params.id);",
      "  if (!order) return res.status(404).json({ message: 'Заказ не найден' });",
      "",
      "  const items = db.prepare(`",
      "    SELECT oi.*, p.name as product_name, p.article",
      "    FROM order_items oi",
      "    JOIN products p ON p.id = oi.product_id",
      "    WHERE oi.order_id = ?",
      "  `).all(req.params.id);",
      "",
      "  res.json({ ...order, items });",
      "});",
      "",
      "/* #API_ЗАКАЗЫ_CRUD — admin → !order-crud */",
      "// app.post('/api/orders', requireAuth, requireRole('admin'), (req, res) => { /* создание */ });",
      "// app.put('/api/orders/:id', requireAuth, requireRole('admin'), (req, res) => { /* редактирование + статус */ });",
      "// app.delete('/api/orders/:id', requireAuth, requireRole('admin'), (req, res) => { /* удаление */ });",
      "",
      "/* #API_ТОВАРЫ_CRUD — admin → !product-crud */",
      "// app.post('/api/admin/products', requireAuth, requireRole('admin'), (req, res) => { /* ... */ });",
      "// app.put('/api/admin/products/:id', requireAuth, requireRole('admin'), (req, res) => { /* ... */ });",
      "// app.delete('/api/admin/products/:id', requireAuth, requireRole('admin'), (req, res) => { /* ... */ });",
      "",
      "/* #API_СПРАВОЧНИКИ — admin → !growing-conditions, !roles-table */",
      "// app.post('/api/admin/growing-conditions', requireAuth, requireRole('admin'), (req, res) => { /* ... */ });",
      "",
      "/* --- Обработка 404 --- */",
      "app.use((req, res) => {",
      "  res.status(404).send('<h1>404 — Страница не найдена</h1><a href=\"/\">На главную</a>');",
      "});",
      "",
      "/* --- Обработка ошибок --- */",
      "app.use((err, req, res, next) => {",
      "  console.error('[ERROR]', err);",
      "  logEvent('error', err.message, req.ip);",
      "  res.status(500).json({ message: 'Внутренняя ошибка сервера' });",
      "});",
      "",
      "/* --- Запуск сервера --- */",
      "/* #WEBSOCKET — используйте server.listen вместо app.listen */",
      "app.listen(PORT, () => {",
      "  console.log(`",
      "  ╔══════════════════════════════════════════════╗",
      "  ║  Сервер запущен: http://localhost:\\${PORT}       ║",
      "  ║  Admin: login=admin / password=admin123      ║",
      "  ║  БД: database.db (SQLite3)                   ║",
      "  ╚══════════════════════════════════════════════╝",
      "  `);",
      "});",
      "",
      "/* Graceful shutdown */",
      "process.on('SIGINT', () => {",
      "  db.close();",
      "  process.exit(0);",
      "});",
      ""
