      "      <!--",
      "      <div class=\"form-group\">",
      "        <label for=\"password\">Пароль</label>",
      "        <div style=\"position:relative\">",
      "          <input type=\"password\" id=\"password\" name=\"password\" placeholder=\"Введите пароль\" required style=\"padding-right:48px\">",
      "          <button type=\"button\" class=\"toggle-password\" style=\"position:absolute;right:12px;top:50%;transform:translateY(-50%);background:none;border:none;cursor:pointer;font-size:18px\">👁</button>",
