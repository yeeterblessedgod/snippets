  "Catalog JS": {
    "prefix": "!catalog-js",
    "body": [
      "/* =============================================================================",
      "   #CATALOG_JS — логика каталога «Зелёный Сад»",
      "   Сниппет: !catalog-js",
      "   Файл: public/js/catalog.js",
      "   ",
      "   Страница: catalog.html (!catalog)",
      "   API: GET /api/products, GET /api/me",
      "   ============================================================================= */",
      "",
      "const ROLE_CAN_FILTER = ['manager', 'admin'];",
      "",
      "document.addEventListener('DOMContentLoaded', async () => {",
      "  let userRole = 'guest';",
      "",
      "  try {",
      "    const me = await fetch('/api/me', { credentials: 'same-origin' });",
      "    if (me.ok) {",
      "      const user = await me.json();",
      "      userRole = user.role_name || user.role || 'client';",
      "      document.getElementById('catalog-login-link')?.classList.add('hidden');",
      "      document.getElementById('catalog-logout-form')?.classList.remove('hidden');",
      "      const roleEl = document.getElementById('catalog-user-role');",
      "      if (roleEl) roleEl.textContent = user.login + ' (' + userRole + ')';",
      "    }",
      "  } catch { /* guest */ }",
      "",
      "  if (ROLE_CAN_FILTER.includes(userRole)) {",
      "    document.getElementById('catalog-filters')?.classList.remove('hidden');",
      "    initFilters();",
      "  }",
      "",
      "  loadProducts();",
      "});",
      "",
      "function getFilterParams() {",
      "  const params = new URLSearchParams();",
      "  const search = document.getElementById('filter-search')?.value;",
      "  const sort = document.getElementById('filter-sort')?.value;",
      "  const category = document.getElementById('filter-category')?.value;",
      "  const type = document.getElementById('filter-type')?.value;",
      "  const condition = document.getElementById('filter-condition')?.value;",
      "  if (search) params.set('search', search);",
      "  if (sort) params.set('sort', sort);",
      "  if (category) params.set('category', category);",
      "  if (type) params.set('type', type);",
      "  if (condition) params.set('condition', condition);",
      "  return params.toString();",
      "}",
      "",
      "function initFilters() {",
      "  document.getElementById('filter-apply')?.addEventListener('click', loadProducts);",
      "  document.getElementById('filter-reset')?.addEventListener('click', () => {",
      "    document.querySelectorAll('#catalog-filters input, #catalog-filters select').forEach(el => {",
      "      if (el.type === 'search' || el.tagName === 'SELECT') el.value = '';",
      "    });",
      "    loadProducts();",
      "  });",
      "",
      "  fetch('/api/growing-conditions')",
      "    .then(r => r.json())",
      "    .then(list => {",
      "      const sel = document.getElementById('filter-condition');",
      "      if (!sel) return;",
      "      list.forEach(c => {",
      "        const opt = document.createElement('option');",
      "        opt.value = c.id;",
      "        opt.textContent = `\\${c.climate_zone} / \\${c.sunlight}`;",
      "        sel.appendChild(opt);",
      "      });",
      "    })",
      "    .catch(() => {});",
      "}",
      "",
      "async function loadProducts() {",
      "  const grid = document.getElementById('products-grid');",
      "  if (!grid) return;",
      "",
      "  const qs = getFilterParams();",
      "  const url = '/api/products' + (qs ? '?' + qs : '');",
      "",
      "  try {",
      "    const res = await fetch(url);",
      "    const products = await res.json();",
      "",
      "    if (!products.length) {",
      "      grid.innerHTML = '<p style=\"grid-column:1/-1;text-align:center\">Товары не найдены</p>';",
      "      return;",
      "    }",
      "",
      "    grid.innerHTML = products.map(p => `",
      "      <article class=\"product-card-garden\">",
      "        <img class=\"product-image\" src=\"\\${p.image_path || '/images/placeholder-plant.jpg'}\" alt=\"\\${p.name}\">",
      "        <div class=\"product-body\">",
      "          <span class=\"product-badge\">\\${p.category}</span>",
      "          <h3>\\${p.name}</h3>",
      "          <p class=\"product-article\">Арт: \\${p.article}</p>",
      "          <p class=\"product-meta\">Тип: \\${p.type} · \\${p.brand}</p>",
      "          <p class=\"product-stock\">На складе: \\${p.quantity} шт.</p>",
      "          <div class=\"product-footer\">",
      "            <span class=\"product-price\">\\${Number(p.price).toFixed(0)} ₽</span>",
      "          </div>",
      "        </div>",
      "      </article>",
      "    `).join('');",
      "  } catch {",
      "    grid.innerHTML = '<p style=\"color:#ef4444\">Ошибка загрузки. Проверьте server.js (#API_КАТАЛОГ)</p>';",
      "  }",
      "}",
      ""
    ],
