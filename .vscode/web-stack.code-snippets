      "",
      "  if (!login || !password) {",
      "    return res.redirect('/reg.html?error=empty');",
      "  }",
      "",
      "  if (password_confirm && password !== password_confirm) {",
      "    return res.redirect('/reg.html?error=mismatch');",
      "  }",
      "",
      "  const exists = db.prepare('SELECT id FROM users WHERE login = ? OR email = ?').get(login, email || '');",
      "  if (exists) {",
      "    return res.redirect('/reg.html?error=exists');",
      "  }",
      "",
      "  const hash = bcrypt.hashSync(password, 10);",
      "  db.prepare('INSERT INTO users (login, email, password_hash) VALUES (?, ?, ?)').run(login, email || null, hash);",
      "",
      "  logEvent('info', `Регистрация: \\${login}`, req.ip);",
      "  res.redirect('/login.html?registered=1');",
      "});",
