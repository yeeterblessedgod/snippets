  "CAPTCHA JS": {
    "prefix": "!captcha-js",
    "body": [
      "/* =============================================================================",
      "   #CAPTCHA_JS — клиентская логика капчи",
      "   Сниппет: !captcha-js",
      "   Файл: public/js/captcha.js",
      "   ",
      "   ПОДКЛЮЧЕНИЕ в reg.html (после !captcha):",
      "     <script src=\"/js/captcha.js\"></script>",
      "   ",
      "   СЕРВЕР: server.js → #CAPTCHA_ПРОВЕРКА и GET /api/captcha",
      "   ============================================================================= */",
      "",
      "document.addEventListener('DOMContentLoaded', () => {",
      "  const questionEl = document.getElementById('captcha-question');",
      "  const tokenEl = document.getElementById('captcha_token');",
      "  const refreshBtn = document.getElementById('captcha-refresh');",
      "  const form = document.getElementById('reg-form');",
      "",
      "  if (!questionEl) return;",
      "",
      "  async function loadCaptcha() {",
      "    try {",
      "      const res = await fetch('/api/captcha');",
      "      const data = await res.json();",
      "      questionEl.textContent = data.question;",
      "      tokenEl.value = data.token;",
      "    } catch {",
      "      /* Fallback без сервера — локальная капча для вёрстки */",
      "      const a = Math.floor(Math.random() * 9) + 1;",
      "      const b = Math.floor(Math.random() * 9) + 1;",
      "      questionEl.textContent = `\\${a} + \\${b} = ?`;",
      "      tokenEl.value = 'local';",
      "      tokenEl.dataset.answer = String(a + b);",
      "    }",
      "  }",
      "",
      "  refreshBtn?.addEventListener('click', loadCaptcha);",
      "  loadCaptcha();",
      "",
      "  form?.addEventListener('submit', (e) => {",
      "    const answer = document.getElementById('captcha_answer')?.value;",
      "    if (!answer) {",
      "      e.preventDefault();",
      "      alert('Решите пример CAPTCHA');",
      "    }",
      "  });",
      "});",
      ""
