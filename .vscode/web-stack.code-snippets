      "    </form>",
      "",
      "    <!-- ================================================================",
      "         #КНОПКА_ВОЙТИ_КАК_ГОСТЬ — раскомментируйте для входа без регистрации",
      "         На сервере: раскомментируйте #МАРШРУТ_ГОСТЬ в server.js (!server)",
      "         В auth.js: раскомментируйте #КНОПКА_ВОЙТИ_КАК_ГОСТЬ",
      "         Сниппет (отдельная вставка): !guest-button",
      "         ================================================================ -->",
      "    <!--",
      "    <div class=\"auth-divider\">или</div>",
      "    <button type=\"button\" id=\"guest-login-btn\" class=\"btn btn-secondary btn-block\">",
      "      Войти как гость",
      "    </button>",
      "    -->",
      "",
      "    <!-- ================================================================",
      "         #ВХОД_ЧЕРЕЗ_СОЦСЕТИ — раскомментируйте для OAuth-кнопок",
      "         На сервере: раскомментируйте #OAUTH_GOOGLE / #OAUTH_VK в server.js",
      "         Сниппет: !social-login",
      "         ================================================================ -->",
      "    <!--",
      "    <div class=\"auth-divider\">или войти через</div>",
      "    <div style=\"display:flex;gap:12px\">",
      "      <a href=\"/auth/google\" class=\"btn btn-secondary btn-block\">Google</a>",
      "      <a href=\"/auth/vk\" class=\"btn btn-secondary btn-block\">VK</a>",
      "    </div>",
      "    -->",
      "",
      "    <!-- ================================================================",
      "         #КАПЧА — раскомментируйте для защиты от ботов",
      "         На сервере: раскомментируйте #CAPTCHA в server.js",
      "         Сниппет: !captcha",
      "         ================================================================ -->",
      "    <!--",
      "    <div class=\"form-group\" style=\"margin-top:20px\">",
      "      <label>Подтвердите, что вы не робот</label>",
      "      <div id=\"captcha-container\"></div>",
      "      <input type=\"hidden\" name=\"captcha_token\" id=\"captcha_token\">",
      "    </div>",
      "    -->",
      "",
      "    <!-- ================================================================",
      "         #ДВУХФАКТОРНАЯ_АУТЕНТИФИКАЦИЯ — раскомментируйте для 2FA",
      "         На сервере: раскомментируйте #2FA в server.js",
      "         Сниппет: !2fa-input",
      "         ================================================================ -->",
      "    <!--",
      "    <div class=\"form-group hidden\" id=\"twofa-block\">",
      "      <label for=\"twofa_code\">Код из приложения (2FA)</label>",
      "      <input type=\"text\" id=\"twofa_code\" name=\"twofa_code\" placeholder=\"000000\" maxlength=\"6\" pattern=\"[0-9]{6}\">",
      "    </div>",
      "    -->",
      "",
      "    <div class=\"auth-links\">",
      "      <!-- #ЗАБЫЛИ_ПАРОЛЬ — раскомментируйте; страница: forgot.html, сниппет: !forgot -->",
      "      <!-- <a href=\"/forgot.html\">Забыли пароль?</a> · -->",
