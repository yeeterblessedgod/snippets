  "Admin JS": {
    "prefix": "!admin-js",
    "body": [
      "/* =============================================================================",
      "   КЛИЕНТСКИЙ JS — АДМИН-ПАНЕЛЬ",
      "   Сниппет: !admin-js",
      "   Подключение: admin.html → <script src=\"/js/admin.js\"></script>",
      "   ============================================================================= */",
      "",
      "document.addEventListener('DOMContentLoaded', () => {",
      "  initTabs();",
      "  loadAdminStats();",
      "  loadUsers();",
      "});",
      "",
      "/* --- Переключение вкладок --- */",
      "function initTabs() {",
      "  document.querySelectorAll('[data-tab]').forEach(link => {",
      "    link.addEventListener('click', (e) => {",
      "      e.preventDefault();",
      "      const tab = link.dataset.tab;",
      "      document.querySelectorAll('[id^=\"tab-\"]').forEach(s => s.classList.add('hidden'));",
      "      document.getElementById(`tab-\\${tab}`)?.classList.remove('hidden');",
      "      document.querySelectorAll('.sidebar-nav a').forEach(a => a.classList.remove('active'));",
      "      link.classList.add('active');",
      "    });",
      "  });",
      "}",
      "",
      "/* --- Загрузка статистики --- */",
      "async function loadAdminStats() {",
      "  try {",
      "    const res = await fetch('/api/admin/stats', { credentials: 'same-origin' });",
      "    if (res.status === 403) {",
      "      window.location.href = '/osnova.html';",
      "      return;",
      "    }",
      "    const data = await res.json();",
      "    document.getElementById('admin-stat-users').textContent = data.users ?? '—';",
      "    document.getElementById('admin-stat-new').textContent = data.newToday ?? '—';",
      "    document.getElementById('admin-stat-sessions').textContent = data.sessions ?? '—';",
      "  } catch {",
      "    /* API не настроен — оставляем прочерки */",
      "  }",
      "}",
      "",
      "/* --- Загрузка таблицы пользователей --- */",
      "async function loadUsers() {",
      "  const tbody = document.getElementById('users-table-body');",
      "  if (!tbody) return;",
      "",
      "  try {",
      "    const res = await fetch('/api/admin/users', { credentials: 'same-origin' });",
      "    const users = await res.json();",
      "",
      "    tbody.innerHTML = users.map(u => `",
      "      <tr>",
      "        <td>\\${u.id}</td>",
      "        <td>\\${u.login}</td>",
      "        <td>\\${u.email || '—'}</td>",
      "        <td><span class=\"badge badge-\\${u.role === 'admin' ? 'admin' : 'user'}\">\\${u.role}</span></td>",
      "        <td><span class=\"badge badge-\\${u.status === 'banned' ? 'banned' : 'active'}\">\\${u.status || 'active'}</span></td>",
      "        <td>\\${u.created_at || '—'}</td>",
      "        <td>",
      "          <button class=\"btn btn-secondary btn-sm\" data-edit=\"\\${u.id}\">Изм.</button>",
      "          <button class=\"btn btn-danger btn-sm\" data-ban=\"\\${u.id}\">Бан</button>",
      "        </td>",
      "      </tr>",
      "    `).join('');",
      "  } catch {",
      "    tbody.innerHTML = '<tr><td colspan=\"7\" style=\"text-align:center\">Ошибка загрузки. Проверьте server.js (#API_АДМИН)</td></tr>';",
      "  }",
      "}",
      "",
      "/* --- Сохранение настроек --- */",
      "document.getElementById('admin-settings-form')?.addEventListener('submit', async (e) => {",
      "  e.preventDefault();",
      "  const form = e.target;",
      "  const data = Object.fromEntries(new FormData(form));",
      "  await fetch('/api/admin/settings', {",
      "    method: 'POST',",
      "    headers: { 'Content-Type': 'application/json' },",
      "    body: JSON.stringify(data),",
      "    credentials: 'same-origin'",
      "  });",
      "  alert('Настройки сохранены');",
      "});",
      "",
      "/* =============================================================================",
      "   #МОДАЛЬНОЕ_ОКНО — раскомментируйте с HTML #МОДАЛЬНОЕ_ОКНО в admin.html",
      "   ============================================================================= */",
      "/*",
      "document.querySelectorAll('[data-close-modal]').forEach(btn => {",
      "  btn.addEventListener('click', () => btn.closest('.modal-overlay').classList.add('hidden'));",
      "});",
      "",
      "document.getElementById('edit-user-form')?.addEventListener('submit', async (e) => {",
      "  e.preventDefault();",
      "  const form = e.target;",
      "  const id = form.querySelector('#edit-user-id').value;",
      "  const data = Object.fromEntries(new FormData(form));",
      "  await fetch(`/api/admin/users/\\${id}`, {",
      "    method: 'PUT',",
      "    headers: { 'Content-Type': 'application/json' },",
      "    body: JSON.stringify(data)",
      "  });",
      "  document.getElementById('edit-user-modal').classList.add('hidden');",
      "  loadUsers();",
      "});",
      "*/",
      "",
      "/* =============================================================================",
      "   #ГРАФИКИ Chart.js — раскомментируйте с блоком #ГРАФИКИ в admin.html",
      "   ============================================================================= */",
      "/*",
      "async function initCharts() {",
      "  const res = await fetch('/api/admin/charts');",
      "  const { labels, values } = await res.json();",
      "  new Chart(document.getElementById('registrations-chart'), {",
      "    type: 'line',",
      "    data: { labels, datasets: [{ label: 'Регистрации', data: values, borderColor: '#3b82f6' }] }",
      "  });",
      "}",
      "initCharts();",
