  "Orders JS": {
    "prefix": "!orders-js",
    "body": [
      "/* =============================================================================",
      "   #ORDERS_JS — модуль заказов (ТЗ)",
      "   Сниппет: !orders-js",
      "   Файл: public/js/orders.js",
      "   ",
      "   Страница: orders.html (!orders)",
      "   Роли: manager (read), admin (CRUD)",
      "   ============================================================================= */",
      "",
      "const STATUS_LABELS = {",
      "  new: 'Новый',",
      "  processing: 'В обработке',",
      "  shipped: 'Отправлен',",
      "  completed: 'Завершён',",
      "  cancelled: 'Отменён'",
      "};",
      "",
      "document.addEventListener('DOMContentLoaded', () => {",
      "  loadOrdersList();",
      "  document.getElementById('create-order-btn')?.addEventListener('click', openOrderModal);",
      "  document.getElementById('order-crud-form')?.addEventListener('submit', saveOrder);",
      "});",
      "",
      "async function loadOrdersList() {",
      "  const tbody = document.getElementById('orders-table-body') || document.getElementById('orders-list-body');",
      "  if (!tbody) return;",
      "",
      "  try {",
      "    const res = await fetch('/api/orders', { credentials: 'same-origin' });",
      "    if (res.status === 403) {",
      "      tbody.innerHTML = '<tr><td colspan=\"6\">Доступ только для manager/admin</td></tr>';",
      "      return;",
      "    }",
      "    const orders = await res.json();",
      "",
      "    tbody.innerHTML = orders.map(o => `",
      "      <tr>",
      "        <td>\\${o.id}</td>",
      "        <td>\\${o.client_name || o.user_id}</td>",
      "        <td>\\${o.order_date || o.created_at}</td>",
      "        <td>\\${Number(o.total_amount).toFixed(2)} ₽</td>",
      "        <td><span class=\"status-\\${o.status}\">\\${STATUS_LABELS[o.status] || o.status}</span></td>",
      "        <td>",
      "          <button class=\"btn btn-secondary btn-sm\" onclick=\"showOrderDetail(\\${o.id})\">Детали</button>",
      "        </td>",
      "      </tr>",
      "    `).join('') || '<tr><td colspan=\"6\">Заказов нет</td></tr>';",
      "  } catch {",
      "    tbody.innerHTML = '<tr><td colspan=\"6\">Ошибка. Проверьте #API_ЗАКАЗЫ в server.js</td></tr>';",
      "  }",
      "}",
      "",
      "async function showOrderDetail(id) {",
      "  const panel = document.getElementById('order-detail-panel');",
      "  const res = await fetch(`/api/orders/\\${id}`, { credentials: 'same-origin' });",
      "  const data = await res.json();",
      "",
      "  panel?.classList.remove('hidden');",
      "  document.getElementById('detail-order-id').textContent = id;",
      "  document.getElementById('od-id').textContent = id;",
      "  document.getElementById('od-client').textContent = data.client_name || '—';",
      "  document.getElementById('od-phone').textContent = data.phone || '—';",
      "  document.getElementById('od-address').textContent = data.delivery_address || '—';",
      "  document.getElementById('od-date').textContent = data.order_date || '—';",
      "  document.getElementById('od-total').textContent = Number(data.total_amount).toFixed(2);",
      "",
      "  const itemsBody = document.getElementById('od-items-body');",
      "  if (itemsBody && data.items) {",
      "    itemsBody.innerHTML = data.items.map(i => `",
      "      <tr>",
      "        <td>\\${i.product_name}</td>",
      "        <td>\\${i.article}</td>",
      "        <td>\\${i.count}</td>",
      "        <td>\\${Number(i.price_at_order).toFixed(2)} ₽</td>",
      "        <td>\\${(i.count * i.price_at_order).toFixed(2)} ₽</td>",
      "      </tr>",
      "    `).join('');",
      "  }",
      "}",
      "",
      "function openOrderModal() {",
      "  document.getElementById('order-crud-modal')?.classList.remove('hidden');",
      "}",
      "",
      "async function saveOrder(e) {",
      "  e.preventDefault();",
      "  /* Реализация POST/PUT — см. server.js #API_ЗАКАЗЫ_CRUD */",
      "  alert('Подключите API в server.js (#API_ЗАКАЗЫ_CRUD)');",
      "}",
      "",
      "window.showOrderDetail = showOrderDetail;",
      ""
    ],
    "description": "JS — заказы (orders.js)",
    "scope": "javascript"
  },
  "DB Garden": {
    "prefix": "!db-garden",
    "body": [
      "/**",
      " * =============================================================================",
      " * #DB_GARDEN — схема БД «Зелёный Сад» (ТЗ ДЭ, 3НФ)",
      " * Сниппет: !db-garden",
      " *",
      " * КУДА ВСТАВИТЬ:",
      " *   server.js — замените или дополните блок db.exec() после !server",
      " *",
      " * ТАБЛИЦЫ: roles, users, growing_conditions, products,",
      " *          product_condition_link, orders, order_items",
      " *",
      " * ТЕСТОВЫЕ ДАННЫЕ: !seed-garden (вставьте после создания таблиц)",
      " * =============================================================================",
      " */",
      "",
      "function initGardenDatabase(db) {",
      "  db.exec(`",
      "    CREATE TABLE IF NOT EXISTS roles (",
      "      id INTEGER PRIMARY KEY AUTOINCREMENT,",
      "      role_name TEXT NOT NULL UNIQUE",
      "    );",
      "",
      "    CREATE TABLE IF NOT EXISTS users (",
      "      id INTEGER PRIMARY KEY AUTOINCREMENT,",
      "      login TEXT NOT NULL UNIQUE,",
      "      password_hash TEXT NOT NULL,",
      "      role_id INTEGER NOT NULL,",
      "      full_name TEXT NOT NULL,",
      "      phone TEXT,",
      "      created_at DATETIME DEFAULT CURRENT_TIMESTAMP,",
      "      FOREIGN KEY (role_id) REFERENCES roles(id)",
      "    );",
      "",
      "    CREATE TABLE IF NOT EXISTS growing_conditions (",
      "      id INTEGER PRIMARY KEY AUTOINCREMENT,",
      "      climate_zone TEXT NOT NULL,",
      "      soil_type TEXT NOT NULL,",
      "      sunlight TEXT NOT NULL,",
      "      watering TEXT NOT NULL",
      "    );",
      "",
      "    CREATE TABLE IF NOT EXISTS products (",
      "      id INTEGER PRIMARY KEY AUTOINCREMENT,",
      "      article TEXT NOT NULL UNIQUE,",
      "      name TEXT NOT NULL,",
      "      type TEXT NOT NULL CHECK(type IN ('seed','seedling','plant','bulb')),",
      "      brand TEXT NOT NULL,",
      "      price REAL NOT NULL CHECK(price > 0),",
      "      quantity INTEGER NOT NULL DEFAULT 0 CHECK(quantity >= 0),",
      "      category TEXT NOT NULL,",
      "      description TEXT,",
      "      image_path TEXT,",
      "      planting_season TEXT,",
      "      created_at DATETIME DEFAULT CURRENT_TIMESTAMP",
      "    );",
      "",
      "    CREATE TABLE IF NOT EXISTS product_condition_link (",
      "      product_id INTEGER NOT NULL,",
      "      condition_id INTEGER NOT NULL,",
      "      PRIMARY KEY (product_id, condition_id),",
      "      FOREIGN KEY (product_id) REFERENCES products(id) ON DELETE CASCADE,",
      "      FOREIGN KEY (condition_id) REFERENCES growing_conditions(id) ON DELETE CASCADE",
      "    );",
      "",
      "    CREATE TABLE IF NOT EXISTS orders (",
      "      id INTEGER PRIMARY KEY AUTOINCREMENT,",
      "      user_id INTEGER NOT NULL,",
      "      order_date DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,",
      "      status TEXT NOT NULL DEFAULT 'new' CHECK(status IN ('new','processing','shipped','completed','cancelled')),",
      "      total_amount REAL NOT NULL DEFAULT 0,",
      "      delivery_address TEXT NOT NULL,",
      "      phone TEXT NOT NULL,",
      "      created_at DATETIME DEFAULT CURRENT_TIMESTAMP,",
      "      FOREIGN KEY (user_id) REFERENCES users(id)",
      "    );",
      "",
      "    CREATE TABLE IF NOT EXISTS order_items (",
      "      id INTEGER PRIMARY KEY AUTOINCREMENT,",
      "      order_id INTEGER NOT NULL,",
      "      product_id INTEGER NOT NULL,",
      "      count INTEGER NOT NULL CHECK(count > 0),",
      "      price_at_order REAL NOT NULL,",
      "      FOREIGN KEY (order_id) REFERENCES orders(id) ON DELETE CASCADE,",
      "      FOREIGN KEY (product_id) REFERENCES products(id)",
      "    );",
      "",
      "    CREATE TABLE IF NOT EXISTS captcha_sessions (",
      "      token TEXT PRIMARY KEY,",
      "      answer INTEGER NOT NULL,",
      "      created_at DATETIME DEFAULT CURRENT_TIMESTAMP",
      "    );",
      "  `);",
      "",
      "  /* Роли по ТЗ */",
      "  const roles = ['guest', 'client', 'manager', 'admin'];",
      "  const insertRole = db.prepare('INSERT OR IGNORE INTO roles (id, role_name) VALUES (?, ?)');",
      "  roles.forEach((r, i) => insertRole.run(i + 1, r));",
      "}",
      "",
      "module.exports = { initGardenDatabase };",
      "",
      "/* =============================================================================",
      "   Использование в server.js:",
      "   ",
      "   const { initGardenDatabase } = require('./db-garden');",
      "   initGardenDatabase(db);",
      "   ",
      "   Или скопируйте содержимое initGardenDatabase inline.",
      "   ============================================================================= */",
      ""
    ],
    "description": "JS — схема БД 7 таблиц (ТЗ ДЭ)",
    "scope": "javascript"
  },
