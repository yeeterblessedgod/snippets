      "        <input",
      "          type=\"text\"",
      "          id=\"login\"",
      "          name=\"login\"",
      "          placeholder=\"Придумайте логин\"",
      "          autocomplete=\"username\"",
      "          minlength=\"3\"",
      "          maxlength=\"32\"",
      "          required",
      "        >",
      "      </div>",
      "",
      "      <!-- ================================================================",
      "           #EMAIL — базовое поле email (рекомендуется оставить)",
