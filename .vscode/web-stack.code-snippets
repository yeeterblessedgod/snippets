      "   Подключение: <script src=\"/js/auth.js\"></script>",
      "   Используется на: login.html, reg.html",
      "   Серверные маршруты настраиваются в server.js (!server)",
      "   ============================================================================= */",
      "",
      "/**",
      " * Отправка формы через fetch с обработкой ошибок",
      " * @param {string} url — API endpoint (например /api/login)",
      " * @param {Object} data — тело запроса",
      " * @returns {Promise<Object>}",
      " */",
      "async function apiRequest(url, data = {}) {",
      "  const response = await fetch(url, {",
      "    method: 'POST',",
      "    headers: { 'Content-Type': 'application/json' },",
      "    body: JSON.stringify(data),",
      "    credentials: 'same-origin'",
      "  });",
      "",
      "  const result = await response.json();",
      "",
      "  if (!response.ok) {",
      "    throw new Error(result.message || 'Произошла ошибка');",
      "  }",
      "",
      "  return result;",
      "}",
      "",
      "/**",
      " * Показать сообщение об ошибке в форме",
      " */",
      "function showFormError(formId, message) {",
      "  const form = document.getElementById(formId);",
      "  if (!form) return;",
      "",
      "  let errorEl = form.querySelector('.form-error-global');",
      "  if (!errorEl) {",
      "    errorEl = document.createElement('div');",
      "    errorEl.className = 'alert alert-error form-error-global';",
      "    form.prepend(errorEl);",
      "  }",
      "  errorEl.textContent = message;",
      "  errorEl.classList.remove('hidden');",
      "}",
      "",
      "/**",
      " * Скрыть глобальную ошибку формы",
      " */",
      "function hideFormError(formId) {",
      "  const form = document.getElementById(formId);",
      "  const errorEl = form?.querySelector('.form-error-global');",
      "  if (errorEl) errorEl.classList.add('hidden');",
      "}",
      "",
      "/* =============================================================================",
      "   #ФОРМА_ВХОДА — обработчик для login.html",
      "   Раскомментируйте, если используете AJAX-вход (без перезагрузки страницы).",
      "   Альтернатива: обычная HTML-форма с action=\"/login\" method=\"POST\"",
