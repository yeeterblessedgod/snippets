      "  if (!login || !password) {",
      "    return res.redirect('/login.html?error=empty');",
      "  }",
      "",
      "  const user = db.prepare('SELECT * FROM users WHERE login = ? AND status = ?').get(login, 'active');",
      "",
      "  if (!user || !bcrypt.compareSync(password, user.password_hash)) {",
      "    logEvent('warn', `Неудачный вход: \\${login}`, req.ip);",
      "    return res.redirect('/login.html?error=invalid');",
      "  }",
      "",
      "  req.session.userId = user.id;",
      "  req.session.login = user.login;",
      "  req.session.role = user.role;",
      "",
      "  logEvent('info', `Вход: \\${user.login}`, req.ip);",
      "  res.redirect('/osnova.html?login=success');",
      "});",
      "",
      "/** POST /register — регистрация (HTML-форма) */",
      "app.post('/register', (req, res) => {",
      "  const { login, email, password, password_confirm } = req.body;",
      "",
      "  /* #РЕГИСТРАЦИЯ_ОТКЛЮЧЕНА — проверка настройки */",
      "  // const disabled = db.prepare(\"SELECT value FROM settings WHERE key = 'registration_disabled'\").get();",
