  "Справочник всех сниппетов": {
    "prefix": "!snippet",
    "body": [
      "# ═══════════════════════════════════════════════════════════════════════════════",
      "#  СПРАВОЧНИК СНИППЕТОВ — «Мой сниппет»",
      "#  Префикс: !snippet  →  вставьте в любой файл или создайте SNIPPETS.md",
      "#",
      "#  КАК ПОЛЬЗОВАТЬСЯ:",
      "#    1. Создайте пустой файл",
      "#    2. Наберите !snippet → Enter",
      "#    3. Держите этот файл открытым рядом — подсматривайте, что куда вставлять",
      "#",
      "#  ПРАВИЛО: сначала «фундамент» (шаги 1–10), потом HTML-страницы (11–16)",
      "# ═══════════════════════════════════════════════════════════════════════════════",
      "",
      "",
      "# ─────────────────────────────────────────────────────────────────────────────",
      "#  БЫСТРЫЙ МАРШРУТ (16 ШАГОВ)",
      "# ─────────────────────────────────────────────────────────────────────────────",
      "",
      "#  Шаг │ Создай файл                        │ Набери сниппет",
      "#  ────┼────────────────────────────────────┼──────────────────────────────────",
      "#   1  │ package.json                       │ !package",
      "#   2  │ server.js                          │ !server  (+ !db-garden, !seed-garden)",
      "#   3  │ public/css/styles.css              │ !styles",
      "#   4  │ public/css/brand-garden.css        │ !brand-theme",
      "#   5  │ public/js/auth.js                  │ !auth-js",
      "#   6  │ public/js/captcha.js               │ !captcha-js",
      "#   7  │ public/js/catalog.js               │ !catalog-js",
      "#   8  │ public/js/orders.js                │ !orders-js",
      "#   9  │ public/js/app.js        (опц.)     │ !app-js",
