      "/**",
      " * =============================================================================",
      " * #ROLE_GUARD — middleware разграничения прав (ТЗ)",
      " * Сниппет: !role-guard",
      " *",
      " * КУДА: server.js — после requireAuth",
      " *",
      " * Использование:",
      " *   app.get('/api/orders', requireAuth, requireRole('manager', 'admin'), handler);",
      " *   app.post('/api/admin/products', requireAuth, requireRole('admin'), handler);",
      " * ============================================================================= */",
      "",
      "function requireRole(...allowedRoles) {",
      "  return (req, res, next) => {",
      "    const role = req.session.role_name || req.session.role;",
      "    if (!allowedRoles.includes(role)) {",
      "      if (req.path.startsWith('/api/')) {",
      "        return res.status(403).json({ message: 'Недостаточно прав. Требуется: ' + allowedRoles.join(', ') });",
      "      }",
      "      return res.redirect('/catalog.html');",
      "    }",
      "    next();",
      "  };",
      "}",
      "",
      "module.exports = { requireRole };",
      "",
